import java.io.BufferedReader;
import java.io.File;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

public class ImageAnalysis {

    private static final ArrayList<String> currentScans = new ArrayList<>();

    private static final String PYTHON_SCRIPT = "ai_analysis (1).py";
    private static final String PYTHON_EXE = "python";
    private static final String MODEL_NAME = "lfm3-omni";

    public static void StartPython() {
        try {
            ProcessBuilder pb = new ProcessBuilder("java", "FOWARD");
            pb.redirectErrorStream(true);
            Process proc = pb.start();
            try (BufferedReader br = new BufferedReader(
                    new InputStreamReader(proc.getInputStream()))) {
                String line;
                while ((line = br.readLine()) != null) {
                    System.out.println("[FOWARD] " + line);
                }
            }
            proc.waitFor();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public static void analyzeFolder(File folder) {
        if (folder == null || !folder.isDirectory()) {
            System.err.println("Not a folder: " + folder);
            return;
        }

        File[] files = folder.listFiles((dir, name) -> {
            String lower = name.toLowerCase();
            return lower.endsWith(".jpg") || lower.endsWith(".jpeg") ||
                   lower.endsWith(".png") || lower.endsWith(".bmp") ||
                   lower.endsWith(".gif");
        });

        if (files == null || files.length == 0) {
            System.out.println("No images found in " + folder);
            return;
        }

        analyzeAll(files);
    }

    public static String analyze(File imageFile) {
        try {
            ProcessBuilder pb = new ProcessBuilder(
                PYTHON_EXE, PYTHON_SCRIPT,
                MODEL_NAME,
                "--image", imageFile.getAbsolutePath()
            );
            pb.redirectErrorStream(true);
            pb.directory(new File("."));

            Process proc = pb.start();

            String scanLine = null;
            try (BufferedReader br = new BufferedReader(
                    new InputStreamReader(proc.getInputStream()))) {
                String line;
                while ((line = br.readLine()) != null) {
                    line = line.trim();
                    if (line.startsWith("{")) {
                        System.out.println("RAW JSON LINE: " + line);
                        scanLine = extractResponse(line);
                    } else {
                        System.out.println("[ai.py] " + line);
                    }
                }
            }

            int exit = proc.waitFor();
            if (exit != 0) {
                System.err.println("ai.py exited with " + exit + " for " + imageFile);
            }

            return scanLine;

        } catch (Exception e) {
            System.err.println("ImageAnalysis failed for " + imageFile + ": " + e.getMessage());
            e.printStackTrace();
            return null;
        }
    }

    private static String extractResponse(String json) {
        java.util.regex.Matcher m = java.util.regex.Pattern
            .compile("\"response\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"")
            .matcher(json);
        if (!m.find()) return null;
        String raw = m.group(1);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < raw.length(); i++) {
            char c = raw.charAt(i);
            if (c == '\\' && i + 1 < raw.length()) {
                char n = raw.charAt(++i);
                switch (n) {
                    case 'n': sb.append('\n'); break;
                    case 't': sb.append('\t'); break;
                    case 'r': sb.append('\r'); break;
                    case '"': sb.append('"'); break;
                    case '\\': sb.append('\\'); break;
                    case '/': sb.append('/'); break;
                    case 'u':
                        if (i + 4 < raw.length()) {
                            sb.append((char) Integer.parseInt(raw.substring(i+1, i+5), 16));
                            i += 4;
                        }
                        break;
                    default: sb.append(n);
                }
            } else {
                sb.append(c);
            }
        }
        return sb.toString().trim();
    }

    public static void analyzeAll(File[] files) {
        currentScans.clear();
        for (File f : files) {
            String scan = analyze(f);
            if (scan != null && !scan.isBlank()) {
                currentScans.add(scan);
            }
        }
    }

    public static List<String> getCurrentScans() {
        return Collections.unmodifiableList(currentScans);
    }

    public static void clear() { currentScans.clear(); }

    public static void main(String[] args) {
        if (args.length == 0) {
            System.out.println("Usage: java ImageAnalysis <folder>");
            return;
        }
        analyzeFolder(new File(args[0]));
        System.out.println("Results: " + getCurrentScans());
        StartPython();
    }
}
